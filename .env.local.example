# Twilio WhatsApp Sandbox · Live participant interactivity
#
# After signing up at twilio.com and visiting:
#   Messaging → Try it out → Send a WhatsApp message
# You'll see your sandbox number and a join code. Copy them below.
#
# The sandbox number is shared across all Twilio trial accounts — it's always
# +1 415 523 8886 — but your join code is unique to your sandbox.

# WhatsApp sandbox number, digits only (no plus, no spaces)
NEXT_PUBLIC_TWILIO_SANDBOX_NUMBER=14155238886

# The join code your sandbox displays, without "join " prefix (e.g. silver-fox)
NEXT_PUBLIC_TWILIO_SANDBOX_JOIN_CODE=YOUR-JOIN-CODE
